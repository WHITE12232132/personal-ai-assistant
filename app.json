{
  "expo": {
    "name": "个人本地AI助手",
    "slug": "beaster-app",
    "scheme": "beaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-light.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beaster.app",
      "buildNumber": "1",
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-light-transparent.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F7",
        "foregroundImage": "./assets/icon-light-transparent.png",
        "monochromeImage": "./assets/icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.beaster.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/icon-light.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-light-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F7",
          "dark": {
            "image": "./assets/icon-dark-transparent.png",
            "backgroundColor": "#1C1C1E"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "607caf98-5489-438a-8575-757aec8f80fa"
      }
    }
  }
}
